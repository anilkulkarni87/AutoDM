{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/purge",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/warmup",
      "schedule": "0 0 * * *"
    }
  ]
}
